diff --git a/tests/test_unvalidated_writes.py b/tests/test_unvalidated_writes.py
new file mode 100644
index 0000000..1ae58d9
--- /dev/null
+++ b/tests/test_unvalidated_writes.py
@@ -0,0 +1,156 @@
+"""Code changes without any validation: write tools touched code files but no
+test/build/lint command ran in the whole session.
+
+Only writes to code files count (docs/config have nothing a test run would
+catch); writes through shell redirection are not counted, keeping the rule
+explainable in one sentence.
+"""
+
+import unittest
+from types import SimpleNamespace
+
+from agent_trajviz.insight.patterns import detect_unvalidated_writes
+from agent_trajviz.insight.issues import prepare_overview_issues
+from agent_trajviz.insight.presenters.issues import build_overview_issues_html
+
+
+def _step(index, calls=None):
+    return {"index": index, "role": "assistant", "tool_calls": calls or [], "tokens": {}}
+
+
+def _write(path="src/app.py", status="completed"):
+    return {
+        "tool_name": "edit",
+        "status": status,
+        "input": {"filePath": path, "old_string": "x", "new_string": "y"},
+        "output": "ok",
+    }
+
+
+def _bash(command, status="completed"):
+    return {
+        "tool_name": "bash",
+        "status": status,
+        "input": {"command": command},
+        "output": "ok",
+    }
+
+
+def _session(**kwargs):
+    base = dict(
+        steps=[],
+        failure_patterns=[],
+        failure_chains=[],
+        fruitless_streaks=[],
+        tool_selection=[],
+        plan_metrics={},
+        plan_history=[],
+        edit_thrash=[],
+        repeated_searches=[],
+        oversized_outputs=[],
+        blind_retries=[],
+        user_repeats=[],
+        unvalidated_writes=[],
+        redundant_re_reads=[],
+        phase_regressions=[],
+        performance_bottlenecks=[],
+        premature_compactions=[],
+        compaction_aftermath=[],
+        file_interactions=[],
+        format="",
+    )
+    base.update(kwargs)
+    return SimpleNamespace(**base)
+
+
+class DetectUnvalidatedWritesTests(unittest.TestCase):
+    def test_code_writes_without_validation_are_flagged(self):
+        steps = [
+            _step(2, [_write("src/app.py")]),
+            _step(5, [_write("src/lib/util.py")]),
+        ]
+        hits = detect_unvalidated_writes(steps)
+        self.assertEqual(len(hits), 1)
+        self.assertEqual(hits[0]["files"], 2)
+        self.assertEqual(hits[0]["steps"], [2, 5])
+
+    def test_a_single_validation_command_clears_the_flag(self):
+        steps = [
+            _step(2, [_write("src/app.py")]),
+            _step(4, [_bash("pytest -q tests/")]),
+        ]
+        self.assertEqual(detect_unvalidated_writes(steps), [])
+
+    def test_build_and_lint_commands_also_count_as_validation(self):
+        for cmd in ("make -j8", "npm run build", "ruff check src/"):
+            steps = [_step(1, [_write("src/app.py")]), _step(3, [_bash(cmd)])]
+            self.assertEqual(detect_unvalidated_writes(steps), [], cmd)
+
+    def test_doc_and_config_writes_are_ignored(self):
+        steps = [
+            _step(1, [_write("README.md")]),
+            _step(2, [_write("config/settings.json")]),
+        ]
+        self.assertEqual(detect_unvalidated_writes(steps), [])
+
+    def test_failed_writes_do_not_count(self):
+        steps = [_step(1, [_write("src/app.py", status="error")])]
+        self.assertEqual(detect_unvalidated_writes(steps), [])
+
+    def test_running_the_written_program_clears_the_flag(self):
+        # python3 app.py is a smoke run — it checks the result.
+        steps = [
+            _step(1, [_write("bisect_demo.py")]),
+            _step(3, [_bash("python3 bisect_demo.py")]),
+        ]
+        self.assertEqual(detect_unvalidated_writes(steps), [])
+
+    def test_version_probes_are_not_smoke_runs(self):
+        steps = [
+            _step(1, [_write("src/app.py")]),
+            _step(3, [_bash("python3 --version")]),
+        ]
+        self.assertEqual(len(detect_unvalidated_writes(steps)), 1)
+
+    def test_read_only_sessions_are_not_flagged(self):
+        steps = [_step(1, [{"tool_name": "read", "status": "completed",
+                            "input": {"filePath": "src/app.py"}, "output": "..."}])]
+        self.assertEqual(detect_unvalidated_writes(steps), [])
+
+    def test_same_file_written_twice_counts_one_file(self):
+        steps = [_step(1, [_write("src/app.py")]), _step(3, [_write("src/app.py")])]
+        hits = detect_unvalidated_writes(steps)
+        self.assertEqual(hits[0]["files"], 1)
+        self.assertEqual(hits[0]["steps"], [1, 3])
+
+
+class UnvalidatedWritesCardTests(unittest.TestCase):
+    def _hits(self):
+        return [{"files": 3, "steps": [2, 5, 9]}]
+
+    def test_card_is_built_from_the_detector_output(self):
+        issues = prepare_overview_issues(_session(unvalidated_writes=self._hits()))
+        card = [i for i in issues if i.source_id == "antipattern:unvalidated_writes"]
+        self.assertEqual(len(card), 1)
+        self.assertEqual(card[0].kind, "antipattern")
+        self.assertEqual(card[0].title, "Code changes were never validated")
+        self.assertIn("3 code file(s) written in steps 2–9", card[0].detail)
+        self.assertEqual(card[0].steps, (2, 5, 9))
+
+    def test_no_card_when_nothing_was_flagged(self):
+        issues = prepare_overview_issues(_session())
+        self.assertFalse(
+            [i for i in issues if "unvalidated_writes" in i.source_id]
+        )
+
+    def test_card_is_localized_to_chinese(self):
+        html = build_overview_issues_html(_session(unvalidated_writes=self._hits()))
+        self.assertIn("改了代码但全程未验证", html)
+        self.assertIn("改了 3 个代码文件（第 2–9 步）", html)
+        self.assertIn("整个运行没有任何测试/构建/检查命令", html)
+        self.assertIn("正确性全凭智能体自信", html)
+        self.assertIn("至少验证一次", html)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_user_repeats.py b/tests/test_user_repeats.py
new file mode 100644
index 0000000..3e6cb83
--- /dev/null
+++ b/tests/test_user_repeats.py
@@ -0,0 +1,177 @@
+"""User repeated messages: the exact same user text sent two or more times.
+
+Only whitespace is normalized; anything else ("继续" vs "请继续") is a
+different message and stays out, keeping the rule explainable in one
+sentence.
+"""
+
+import unittest
+from types import SimpleNamespace
+
+from agent_trajviz.insight.patterns import detect_user_repeats
+from agent_trajviz.insight.issues import prepare_overview_issues
+from agent_trajviz.insight.presenters.issues import build_overview_issues_html
+
+
+def _user(index, text):
+    return {"index": index, "role": "user", "text_preview": text, "tokens": {}}
+
+
+def _assistant(index):
+    return {"index": index, "role": "assistant", "text_preview": "done", "tokens": {}}
+
+
+def _session(**kwargs):
+    base = dict(
+        steps=[],
+        failure_patterns=[],
+        failure_chains=[],
+        fruitless_streaks=[],
+        tool_selection=[],
+        plan_metrics={},
+        plan_history=[],
+        edit_thrash=[],
+        repeated_searches=[],
+        oversized_outputs=[],
+        blind_retries=[],
+        user_repeats=[],
+        unvalidated_writes=[],
+        redundant_re_reads=[],
+        phase_regressions=[],
+        performance_bottlenecks=[],
+        premature_compactions=[],
+        compaction_aftermath=[],
+        file_interactions=[],
+        format="",
+    )
+    base.update(kwargs)
+    return SimpleNamespace(**base)
+
+
+class DetectUserRepeatsTests(unittest.TestCase):
+    def test_verbatim_repeat_is_flagged(self):
+        steps = [
+            _user(0, "把报告改成中文"),
+            _assistant(1),
+            _user(2, "把报告改成中文"),
+        ]
+        reps = detect_user_repeats(steps)
+        self.assertEqual(len(reps), 1)
+        self.assertEqual(reps[0]["count"], 2)
+        self.assertEqual(reps[0]["steps"], [0, 2])
+
+    def test_whitespace_differences_do_not_hide_a_repeat(self):
+        steps = [
+            _user(0, "fix the bug\n   in parser.py"),
+            _user(4, "fix the bug in parser.py"),
+        ]
+        reps = detect_user_repeats(steps)
+        self.assertEqual(len(reps), 1)
+        self.assertEqual(reps[0]["message"], "fix the bug in parser.py")
+
+    def test_different_messages_are_not_flagged(self):
+        steps = [
+            _user(0, "继续"),
+            _user(2, "请继续"),
+            _user(4, "继续吧"),
+        ]
+        self.assertEqual(detect_user_repeats(steps), [])
+
+    def test_assistant_text_is_ignored(self):
+        steps = [
+            _user(0, "done"),
+            _assistant(1),  # same text, wrong role
+        ]
+        self.assertEqual(detect_user_repeats(steps), [])
+
+    def test_three_repeats_count_and_sort_first(self):
+        steps = [
+            _user(0, "继续"),
+            _assistant(1),
+            _user(2, "继续"),
+            _assistant(3),
+            _user(4, "继续"),
+            _user(6, "别的消息"),
+            _user(8, "别的消息"),
+        ]
+        reps = detect_user_repeats(steps)
+        self.assertEqual([r["count"] for r in reps], [3, 2])
+        self.assertEqual(reps[0]["steps"], [0, 2, 4])
+
+    def test_empty_messages_are_skipped(self):
+        steps = [_user(0, ""), _user(2, "   ")]
+        self.assertEqual(detect_user_repeats(steps), [])
+
+
+class UserRepeatCardTests(unittest.TestCase):
+    def _repeats(self):
+        return [{"message": "把报告改成中文", "count": 2, "steps": [0, 2]}]
+
+    def test_synthetic_continuation_messages_are_not_user_repeats(self):
+        # OpenCode injects "Continue if you have next steps..." after each
+        # compaction. It repeats verbatim across compactions but the framework
+        # typed it, not the user.
+        def _synthetic(index, text="Continue if you have next steps, or stop."):
+            return {
+                "index": index,
+                "role": "user",
+                "tool_calls": [],
+                "tokens": {},
+                "parts": [{"type": "text", "text": text, "synthetic": True}],
+            }
+
+        steps = [_synthetic(24), _synthetic(33), _synthetic(39)]
+        self.assertEqual(detect_user_repeats(steps), [])
+
+    def test_mixed_synthetic_and_typed_text_uses_the_typed_one(self):
+        step = {
+            "index": 1,
+            "role": "user",
+            "tool_calls": [],
+            "tokens": {},
+            "parts": [
+                {"type": "text", "text": "Continue if you have next steps.", "synthetic": True},
+                {"type": "text", "text": "请继续", "synthetic": False},
+            ],
+        }
+        hits = detect_user_repeats([step, dict(step, index=5)])
+        self.assertEqual(len(hits), 1)
+        self.assertEqual(hits[0]["message"], "请继续")
+
+    def test_typed_text_parts_still_count(self):
+        def _typed(index, text="把报告发我"):
+            return {
+                "index": index,
+                "role": "user",
+                "tool_calls": [],
+                "tokens": {},
+                "parts": [{"type": "text", "text": text}],
+            }
+
+        hits = detect_user_repeats([_typed(1), _typed(4)])
+        self.assertEqual(len(hits), 1)
+        self.assertEqual(hits[0]["count"], 2)
+
+    def test_card_is_built_from_the_detector_output(self):
+        issues = prepare_overview_issues(_session(user_repeats=self._repeats()))
+        card = [i for i in issues if i.source_id == "antipattern:user_repeat:0"]
+        self.assertEqual(len(card), 1)
+        self.assertEqual(card[0].kind, "antipattern")
+        self.assertEqual(card[0].title, "User repeated a message (2×)")
+        self.assertEqual(card[0].detail, "把报告改成中文")
+        self.assertEqual(card[0].steps, (0, 2))
+
+    def test_no_card_when_nothing_was_flagged(self):
+        issues = prepare_overview_issues(_session())
+        self.assertFalse([i for i in issues if "user_repeat" in i.source_id])
+
+    def test_card_is_localized_to_chinese(self):
+        html = build_overview_issues_html(_session(user_repeats=self._repeats()))
+        self.assertIn("用户重复发送同一消息 (2×)", html)
+        self.assertIn("把报告改成中文", html)
+        self.assertIn("最直接的证据", html)
+        self.assertIn("查看第一次发送该消息后智能体的响应", html)
+
+
+if __name__ == "__main__":
+    unittest.main()
