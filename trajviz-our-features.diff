+def _fmt_k(n: float) -> str:
+    """Compact token counts for summary lines: 940 / 12.3k / 1.2M."""
+    n = int(n)
+    if abs(n) < 1000:
+        return f"{n:,}"
+    if abs(n) < 1_000_000:
+        v = n / 1000
+        return f"{v:.1f}k".replace(".0k", "k")
+    return f"{n / 1_000_000:.2f}M"
+
+
+def _fmt_wall(seconds: float) -> str:
+    """Wall-clock duration: 45s / 5m 40s / 2h 05m."""
+    total = int(round(seconds))
+    if total < 60:
+        return f"{total}s"
+    minutes, secs = divmod(total, 60)
+    if minutes < 60:
+        return f"{minutes}m {secs}s" if secs else f"{minutes}m"
+    hours, minutes = divmod(minutes, 60)
+    return f"{hours}h {minutes:02d}m" if minutes else f"{hours}h"
+
+
+def _step_text_parts(step: dict) -> str:
+    """Visible text of a step: its `text` parts joined, whitespace collapsed."""
+    chunks = []
+    for p in step.get("parts") or []:
+        if isinstance(p, dict) and p.get("type") == "text":
+            t = str(p.get("text") or "").strip()
+            if t:
+                chunks.append(t)
+    return " ".join(chunks)
+
