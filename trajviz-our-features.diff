+    try:
+        ai_summary = judge_run_summary(session, config=cfg)
+    except Exception as exc:  # noqa: BLE001 — rows stay hidden; banner explains
+        summary_error = _judge_error_text(exc)
+
+    if not ranked:
+        if _superseded():
