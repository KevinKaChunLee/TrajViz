+            yield build_overview_issues_html(
+                session, issues=ranked, banner=banner, ai_summary=ai_summary,
+            ), payload
+            return
+
+        banner = ""
+        if summary_error:
+            banner = f"Run summary failed: {summary_error[:160]}"
