{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Session details",
  "description": "Where and how the run happened: model, provider, agent, start and end, session id, title, branch, directory, platform and client version, as the export records them (null if absent).",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "description",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "const": "session"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "const": "summary"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "agent",
        "branch",
        "directory",
        "finished_at",
        "model",
        "platform",
        "provider",
        "session_id",
        "started_at",
        "title",
        "version"
      ],
      "properties": {
        "agent": {
          "type": [
            "null",
            "string"
          ]
        },
        "branch": {
          "type": [
            "null",
            "string"
          ]
        },
        "directory": {
          "type": [
            "null",
            "string"
          ]
        },
        "finished_at": {
          "type": [
            "null",
            "string"
          ]
        },
        "model": {
          "type": [
            "null",
            "string"
          ]
        },
        "platform": {
          "type": [
            "null",
            "string"
          ]
        },
        "provider": {
          "type": [
            "null",
            "string"
          ]
        },
        "session_id": {
          "type": [
            "null",
            "string"
          ]
        },
        "started_at": {
          "type": [
            "null",
            "string"
          ]
        },
        "title": {
          "type": [
            "null",
            "string"
          ]
        },
        "version": {
          "type": [
            "null",
            "string"
          ]
        }
      }
    },
    "availability": {
      "type": "object",
      "required": [
        "status",
        "basis",
        "fields"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed",
            "partial",
            "unavailable",
            "unknown"
          ]
        },
        "basis": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "status",
              "observed",
              "partial",
              "total",
              "reasons"
            ],
            "properties": {
              "status": {
                "enum": [
                  "observed",
                  "partial",
                  "unavailable",
                  "unknown"
                ]
              },
              "observed": {
                "type": "integer",
                "minimum": 0
              },
              "partial": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "reasons": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
