{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Failure chains",
  "description": "Runs of consecutive failing assistant steps, with chain statistics.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "description",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "const": "failure_chains"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "const": "table"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "chains",
        "metrics"
      ],
      "properties": {
        "chains": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "end",
              "start",
              "steps"
            ],
            "properties": {
              "end": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "spawning_agent": {
                "type": "string"
              },
              "spawning_step": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "start": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "metrics": {
          "type": "object",
          "required": [
            "chain_step_pct",
            "longest_chain",
            "total_chain_steps",
            "total_chains"
          ],
          "properties": {
            "chain_step_pct": {
              "type": [
                "number",
                "null"
              ]
            },
            "longest_chain": {
              "type": [
                "integer",
                "null"
              ]
            },
            "total_chain_steps": {
              "type": [
                "integer",
                "null"
              ]
            },
            "total_chains": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        }
      }
    },
    "availability": {
      "type": "object",
      "required": [
        "status",
        "basis",
        "fields"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed",
            "partial",
            "unavailable",
            "unknown"
          ]
        },
        "basis": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "status",
              "observed",
              "partial",
              "total",
              "reasons"
            ],
            "properties": {
              "status": {
                "enum": [
                  "observed",
                  "partial",
                  "unavailable",
                  "unknown"
                ]
              },
              "observed": {
                "type": "integer",
                "minimum": 0
              },
              "partial": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "reasons": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
