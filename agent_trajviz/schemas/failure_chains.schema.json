{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Failure chains",
  "description": "Runs of consecutive failing assistant steps, with chain statistics.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "description",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "const": "failure_chains"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "const": "table"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "chains",
        "metrics"
      ],
      "properties": {
        "chains": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "end",
              "start",
              "steps"
            ],
            "properties": {
              "end": {
                "type": "integer"
              },
              "spawning_agent": {
                "type": "string"
              },
              "spawning_step": {
                "type": "integer"
              },
              "start": {
                "type": "integer"
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "metrics": {
          "type": "object",
          "required": [
            "chain_step_pct",
            "longest_chain",
            "total_chain_steps",
            "total_chains"
          ],
          "properties": {
            "chain_step_pct": {
              "type": "number"
            },
            "longest_chain": {
              "type": "integer"
            },
            "total_chain_steps": {
              "type": "integer"
            },
            "total_chains": {
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
