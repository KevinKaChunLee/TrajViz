{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Summary",
  "description": "Provenance and headline numbers: format, steps, agents, tokens, tool use, health and issue count.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "description",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "const": "summary"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "const": "summary"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "agents",
        "assistant_steps",
        "format",
        "format_label",
        "health",
        "issues",
        "output_tokens_per_sec",
        "sha256",
        "source",
        "steps",
        "tokens",
        "tokens_estimated",
        "tool_calls",
        "tool_success_rate",
        "wall_clock_s",
        "warnings"
      ],
      "properties": {
        "agents": {
          "type": [
            "integer",
            "null"
          ]
        },
        "assistant_steps": {
          "type": [
            "integer",
            "null"
          ]
        },
        "format": {
          "type": "string"
        },
        "format_label": {
          "type": "string"
        },
        "health": {
          "type": "object",
          "required": [
            "Cache Efficiency",
            "Errors",
            "Throughput",
            "Tool Success"
          ],
          "properties": {
            "Cache Efficiency": {
              "type": "string",
              "enum": [
                "good",
                "warn",
                "bad",
                "unavailable"
              ]
            },
            "Errors": {
              "type": "string",
              "enum": [
                "good",
                "warn",
                "bad",
                "unavailable"
              ]
            },
            "Throughput": {
              "type": "string",
              "enum": [
                "good",
                "warn",
                "bad",
                "unavailable"
              ]
            },
            "Tool Success": {
              "type": "string",
              "enum": [
                "good",
                "warn",
                "bad",
                "unavailable"
              ]
            }
          }
        },
        "issues": {
          "type": [
            "integer",
            "null"
          ]
        },
        "output_tokens_per_sec": {
          "type": [
            "null",
            "number"
          ]
        },
        "sha256": {
          "type": [
            "null",
            "string"
          ]
        },
        "source": {
          "type": [
            "null",
            "string"
          ]
        },
        "steps": {
          "type": [
            "integer",
            "null"
          ]
        },
        "tokens": {
          "type": "object",
          "required": [
            "cache_read",
            "cache_write",
            "input",
            "output",
            "reasoning",
            "total"
          ],
          "properties": {
            "cache_read": {
              "type": [
                "integer",
                "null"
              ]
            },
            "cache_write": {
              "type": [
                "integer",
                "null"
              ]
            },
            "input": {
              "type": [
                "integer",
                "null"
              ]
            },
            "output": {
              "type": [
                "integer",
                "null"
              ]
            },
            "reasoning": {
              "type": [
                "integer",
                "null"
              ]
            },
            "total": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "tokens_estimated": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tool_calls": {
          "type": [
            "integer",
            "null"
          ]
        },
        "tool_success_rate": {
          "type": [
            "null",
            "number"
          ]
        },
        "wall_clock_s": {
          "type": [
            "number",
            "null"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_quality": {
          "type": "object",
          "required": [
            "source",
            "basis",
            "capture_complete",
            "fields"
          ],
          "properties": {
            "source": {
              "enum": [
                "native",
                "otlp"
              ]
            },
            "basis": {
              "enum": [
                "source_records",
                "captured_operations"
              ]
            },
            "capture_complete": {
              "type": "null"
            },
            "profile": {
              "type": "string"
            },
            "profile_version": {
              "type": "integer"
            },
            "fields": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "status",
                  "observed",
                  "partial",
                  "total",
                  "reasons"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "observed",
                      "partial",
                      "unavailable",
                      "unknown"
                    ]
                  },
                  "observed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "partial": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "total": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "reasons": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "availability": {
      "type": "object",
      "required": [
        "status",
        "basis",
        "fields"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed",
            "partial",
            "unavailable",
            "unknown"
          ]
        },
        "basis": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "status",
              "observed",
              "partial",
              "total",
              "reasons"
            ],
            "properties": {
              "status": {
                "enum": [
                  "observed",
                  "partial",
                  "unavailable",
                  "unknown"
                ]
              },
              "observed": {
                "type": "integer",
                "minimum": 0
              },
              "partial": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "reasons": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
