{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase regressions",
  "description": "Unintended returns to an earlier workflow phase.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "description",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "const": "phase_regressions"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "const": "table"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "category",
          "explanation",
          "from_phase",
          "span_fraction",
          "step_idx",
          "to_phase"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "from_phase": {
            "type": "string"
          },
          "span_fraction": {
            "type": "number"
          },
          "step_idx": {
            "type": "integer"
          },
          "to_phase": {
            "type": "string"
          }
        }
      }
    },
    "availability": {
      "type": "object",
      "required": [
        "status",
        "basis",
        "fields"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed",
            "partial",
            "unavailable",
            "unknown"
          ]
        },
        "basis": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "status",
              "observed",
              "partial",
              "total",
              "reasons"
            ],
            "properties": {
              "status": {
                "enum": [
                  "observed",
                  "partial",
                  "unavailable",
                  "unknown"
                ]
              },
              "observed": {
                "type": "integer",
                "minimum": 0
              },
              "partial": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "reasons": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
