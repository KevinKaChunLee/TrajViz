{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tokens by agent",
  "description": "Token totals per agent with the segments that add up to them.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "description",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "const": "agent_tokens"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "const": "chart"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "agents"
      ],
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "agent_id",
              "cache_read",
              "cache_write",
              "input",
              "input_unusable_steps",
              "label",
              "output",
              "reasoning",
              "segments",
              "total"
            ],
            "properties": {
              "agent_id": {
                "type": "string"
              },
              "cache_read": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "cache_write": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "input": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "input_unusable_steps": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "label": {
                "type": "string"
              },
              "output": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "reasoning": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "segments": {
                "type": "object",
                "required": [
                  "cache_read",
                  "cache_write",
                  "fresh",
                  "output",
                  "reasoning"
                ],
                "properties": {
                  "cache_read": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "cache_write": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "fresh": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "output": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "reasoning": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                }
              },
              "total": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "availability": {
      "type": "object",
      "required": [
        "status",
        "basis",
        "fields"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed",
            "partial",
            "unavailable",
            "unknown"
          ]
        },
        "basis": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "status",
              "observed",
              "partial",
              "total",
              "reasons"
            ],
            "properties": {
              "status": {
                "enum": [
                  "observed",
                  "partial",
                  "unavailable",
                  "unknown"
                ]
              },
              "observed": {
                "type": "integer",
                "minimum": 0
              },
              "partial": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "reasons": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
