{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Steps by phase",
  "description": "Classified assistant steps per workflow phase.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "description",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "const": "label_phase_counts"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "const": "chart"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "counts"
      ],
      "properties": {
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    }
  }
}
