{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fruitless search streaks",
  "description": "Consecutive searches that found nothing.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "description",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "const": "fruitless_streaks"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "const": "table"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "end_step",
          "length",
          "start_step",
          "tools"
        ],
        "properties": {
          "end_step": {
            "type": "number"
          },
          "length": {
            "type": "number"
          },
          "start_step": {
            "type": "number"
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
