{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Failure patterns",
  "description": "Failed tool calls grouped by tool and error.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "description",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "const": "failure_patterns"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "const": "table"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cluster_label",
          "count",
          "error_class",
          "example_error",
          "recovery_path",
          "steps"
        ],
        "properties": {
          "cluster_label": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "error_class": {
            "type": "string",
            "enum": [
              "system",
              "tool"
            ]
          },
          "example_error": {
            "type": "string"
          },
          "recovery_path": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
