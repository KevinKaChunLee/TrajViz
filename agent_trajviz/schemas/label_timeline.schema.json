{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Label timeline",
  "description": "Every labelled step in order with its phase, action and duration (user turns included).",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "description",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "const": "label_timeline"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "const": "chart"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "steps"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "index",
              "role",
              "phase",
              "action"
            ],
            "properties": {
              "action": {
                "type": "string"
              },
              "agent": {
                "type": "string"
              },
              "duration_s": {
                "type": [
                  "null",
                  "number"
                ]
              },
              "executor_id": {
                "type": "string"
              },
              "finish": {
                "type": "string"
              },
              "index": {
                "type": "integer"
              },
              "is_sub_agent": {
                "type": "boolean"
              },
              "model_id": {
                "type": "string"
              },
              "phase": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "round": {},
              "session_id": {
                "type": "string"
              },
              "text_preview": {
                "type": "string"
              },
              "time_completed_ms": {
                "type": [
                  "null",
                  "number",
                  "string"
                ]
              },
              "time_created_ms": {
                "type": [
                  "null",
                  "number",
                  "string"
                ]
              },
              "tokens_total": {
                "type": "integer"
              },
              "tool_calls": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "raw_index": {
                "type": "integer"
              },
              "label_source": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "availability": {
      "type": "object",
      "required": [
        "status",
        "basis",
        "fields"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed",
            "partial",
            "unavailable",
            "unknown"
          ]
        },
        "basis": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "status",
              "observed",
              "partial",
              "total",
              "reasons"
            ],
            "properties": {
              "status": {
                "enum": [
                  "observed",
                  "partial",
                  "unavailable",
                  "unknown"
                ]
              },
              "observed": {
                "type": "integer",
                "minimum": 0
              },
              "partial": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "reasons": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
