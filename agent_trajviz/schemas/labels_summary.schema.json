{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Labels summary",
  "description": "Assistant steps labelled, how many were classified, and the taxonomy and model used.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "description",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "const": "labels_summary"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "const": "summary"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "classification_rate",
        "classified",
        "model",
        "phases",
        "taxonomy_version",
        "total",
        "unknown"
      ],
      "properties": {
        "classification_rate": {
          "type": "number"
        },
        "classified": {
          "type": "integer"
        },
        "model": {
          "type": "string"
        },
        "phases": {
          "type": "integer"
        },
        "taxonomy_version": {
          "type": "string"
        },
        "total": {
          "type": "integer"
        },
        "unknown": {
          "type": "integer"
        }
      }
    },
    "availability": {
      "type": "object",
      "required": [
        "status",
        "basis",
        "fields"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed",
            "partial",
            "unavailable",
            "unknown"
          ]
        },
        "basis": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "status",
              "observed",
              "partial",
              "total",
              "reasons"
            ],
            "properties": {
              "status": {
                "enum": [
                  "observed",
                  "partial",
                  "unavailable",
                  "unknown"
                ]
              },
              "observed": {
                "type": "integer",
                "minimum": 0
              },
              "partial": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "reasons": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
