{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tool calls",
  "description": "Calls per tool, split by agent.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "description",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "const": "tool_usage"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "const": "chart"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "agents",
        "tools"
      ],
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "by_agent",
              "calls",
              "tool"
            ],
            "properties": {
              "by_agent": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                }
              },
              "calls": {
                "type": "integer"
              },
              "tool": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
