{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plan progress",
  "description": "The agent's todo items with the steps they started and finished on, stalled items, and every plan snapshot.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "description",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "const": "plan"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "const": "chart"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "history",
        "metrics"
      ],
      "properties": {
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "items",
              "step"
            ],
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "content",
                    "status"
                  ],
                  "properties": {
                    "content": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    }
                  }
                }
              },
              "step": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        },
        "metrics": {
          "type": "object",
          "required": [
            "items",
            "plan_resets",
            "stalled",
            "total_items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "content",
                  "duration_steps",
                  "end_step",
                  "start_step"
                ],
                "properties": {
                  "content": {
                    "type": "string"
                  },
                  "duration_steps": {
                    "type": [
                      "null",
                      "integer"
                    ]
                  },
                  "end_step": {
                    "type": [
                      "null",
                      "integer"
                    ]
                  },
                  "start_step": {
                    "type": [
                      "null",
                      "integer"
                    ]
                  }
                }
              }
            },
            "plan_resets": {
              "type": [
                "integer",
                "null"
              ]
            },
            "stalled": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "content",
                  "duration_steps",
                  "end_step",
                  "start_step"
                ],
                "properties": {
                  "content": {
                    "type": "string"
                  },
                  "duration_steps": {
                    "type": [
                      "null",
                      "integer"
                    ]
                  },
                  "end_step": {
                    "type": [
                      "null",
                      "integer"
                    ]
                  },
                  "start_step": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                }
              }
            },
            "total_items": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        }
      }
    },
    "availability": {
      "type": "object",
      "required": [
        "status",
        "basis",
        "fields"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed",
            "partial",
            "unavailable",
            "unknown"
          ]
        },
        "basis": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "status",
              "observed",
              "partial",
              "total",
              "reasons"
            ],
            "properties": {
              "status": {
                "enum": [
                  "observed",
                  "partial",
                  "unavailable",
                  "unknown"
                ]
              },
              "observed": {
                "type": "integer",
                "minimum": 0
              },
              "partial": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "reasons": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
