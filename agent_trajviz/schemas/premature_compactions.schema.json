{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Premature compactions",
  "description": "Context compactions that happened well before the window was full.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "description",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "const": "premature_compactions"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "const": "table"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "agent",
          "before_pct",
          "grew",
          "kind",
          "occupancy_after",
          "occupancy_before",
          "reason",
          "step",
          "window_limit"
        ],
        "properties": {
          "agent": {
            "type": "string"
          },
          "before_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "grew": {
            "type": "boolean"
          },
          "kind": {
            "type": "string"
          },
          "occupancy_after": {
            "type": [
              "number",
              "null"
            ]
          },
          "occupancy_before": {
            "type": "number"
          },
          "reason": {
            "type": "string"
          },
          "step": {
            "type": "number"
          },
          "window_limit": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "availability": {
      "type": "object",
      "required": [
        "status",
        "basis",
        "fields"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed",
            "partial",
            "unavailable",
            "unknown"
          ]
        },
        "basis": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "status",
              "observed",
              "partial",
              "total",
              "reasons"
            ],
            "properties": {
              "status": {
                "enum": [
                  "observed",
                  "partial",
                  "unavailable",
                  "unknown"
                ]
              },
              "observed": {
                "type": "integer",
                "minimum": 0
              },
              "partial": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "reasons": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
