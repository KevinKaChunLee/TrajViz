{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diagnostic metrics",
  "description": "Derived diagnostics: error recovery, retries, exploration ratio and related measures.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "description",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "const": "diagnostics"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "const": "summary"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "classified_error_count",
        "edit_precision",
        "edit_success",
        "edit_total",
        "subagent_session_count",
        "subagent_total_steps",
        "subagent_total_tokens"
      ],
      "properties": {
        "classified_error_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "edit_precision": {
          "type": [
            "null",
            "number"
          ]
        },
        "edit_success": {
          "type": [
            "integer",
            "null"
          ]
        },
        "edit_total": {
          "type": [
            "integer",
            "null"
          ]
        },
        "subagent_session_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "subagent_total_steps": {
          "type": [
            "integer",
            "null"
          ]
        },
        "subagent_total_tokens": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "availability": {
      "type": "object",
      "required": [
        "status",
        "basis",
        "fields"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed",
            "partial",
            "unavailable",
            "unknown"
          ]
        },
        "basis": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "status",
              "observed",
              "partial",
              "total",
              "reasons"
            ],
            "properties": {
              "status": {
                "enum": [
                  "observed",
                  "partial",
                  "unavailable",
                  "unknown"
                ]
              },
              "observed": {
                "type": "integer",
                "minimum": 0
              },
              "partial": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "reasons": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
