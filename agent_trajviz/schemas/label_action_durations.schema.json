{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Time by action",
  "description": "Seconds spent in each action, with each action's phase.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "description",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "const": "label_action_durations"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "const": "chart"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "action_to_phase",
        "durations_s"
      ],
      "properties": {
        "action_to_phase": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "durations_s": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    }
  }
}
