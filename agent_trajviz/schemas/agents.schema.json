{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agents",
  "description": "One row per agent (main and sub-agents): steps, tokens, duration, tool calls, errors, cache share and generation rate.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "description",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "const": "agents"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "const": "table"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "agent_id",
          "cache_efficiency_pct",
          "cache_read_tokens",
          "cache_write_tokens",
          "error_count",
          "input_tokens",
          "input_tokens_unusable_steps",
          "label",
          "output_throughput_timed_steps",
          "output_tokens",
          "output_tokens_per_sec",
          "reasoning_tokens",
          "spawned_by_step",
          "step_count",
          "token_unusable_steps",
          "tool_call_count",
          "total_duration_s",
          "total_tokens"
        ],
        "properties": {
          "agent_id": {
            "type": "string"
          },
          "cache_efficiency_pct": {
            "type": [
              "null",
              "number"
            ]
          },
          "cache_read_tokens": {
            "type": [
              "integer",
              "null"
            ]
          },
          "cache_write_tokens": {
            "type": [
              "integer",
              "null"
            ]
          },
          "error_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "input_tokens": {
            "type": [
              "integer",
              "null"
            ]
          },
          "input_tokens_unusable_steps": {
            "type": [
              "integer",
              "null"
            ]
          },
          "label": {
            "type": "string"
          },
          "output_throughput_timed_steps": {
            "type": [
              "integer",
              "null"
            ]
          },
          "output_tokens": {
            "type": [
              "integer",
              "null"
            ]
          },
          "output_tokens_per_sec": {
            "type": [
              "null",
              "number"
            ]
          },
          "reasoning_tokens": {
            "type": [
              "integer",
              "null"
            ]
          },
          "spawned_by_step": {
            "type": [
              "null",
              "integer"
            ]
          },
          "step_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "token_unusable_steps": {
            "type": "object",
            "required": [
              "cache_read",
              "cache_write",
              "input",
              "output",
              "reasoning",
              "total"
            ],
            "properties": {
              "cache_read": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "cache_write": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "input": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "output": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "reasoning": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "total": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          },
          "tool_call_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "total_duration_s": {
            "type": [
              "number",
              "null"
            ]
          },
          "total_tokens": {
            "type": [
              "integer",
              "null"
            ]
          },
          "data_quality": {
            "type": "object",
            "required": [
              "source",
              "basis",
              "capture_complete",
              "fields"
            ],
            "properties": {
              "source": {
                "enum": [
                  "native",
                  "otlp"
                ]
              },
              "basis": {
                "enum": [
                  "source_records",
                  "captured_operations"
                ]
              },
              "capture_complete": {
                "type": "null"
              },
              "profile": {
                "type": "string"
              },
              "profile_version": {
                "type": "integer"
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "status",
                    "observed",
                    "partial",
                    "total",
                    "reasons"
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "observed",
                        "partial",
                        "unavailable",
                        "unknown"
                      ]
                    },
                    "observed": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "partial": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "total": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "reasons": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  }
                }
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "availability": {
      "type": "object",
      "required": [
        "status",
        "basis",
        "fields"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed",
            "partial",
            "unavailable",
            "unknown"
          ]
        },
        "basis": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "status",
              "observed",
              "partial",
              "total",
              "reasons"
            ],
            "properties": {
              "status": {
                "enum": [
                  "observed",
                  "partial",
                  "unavailable",
                  "unknown"
                ]
              },
              "observed": {
                "type": "integer",
                "minimum": 0
              },
              "partial": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "reasons": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
