{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repeated searches",
  "description": "The same search run more than once.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "description",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "const": "repeated_searches"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "const": "table"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "count",
          "display",
          "signature",
          "steps"
        ],
        "properties": {
          "count": {
            "type": "number"
          },
          "display": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
