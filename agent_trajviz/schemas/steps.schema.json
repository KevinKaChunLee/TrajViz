{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Per-step metrics",
  "description": "One row per step: role, agent, finish, duration, tokens, cache share, fresh input and tool calls.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "description",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "const": "steps"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "const": "table"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "agent",
          "cache_ratio",
          "cache_read",
          "duration",
          "errors",
          "finish",
          "index",
          "model_id",
          "non_cache_per_sec",
          "non_cache_tokens",
          "output_input_ratio",
          "patch_parts",
          "reasoning_parts",
          "role",
          "text_parts",
          "tokens_input",
          "tokens_output",
          "tokens_per_sec",
          "tokens_total",
          "tool_calls",
          "tool_time_share",
          "tool_time_sum"
        ],
        "properties": {
          "agent": {
            "type": "string"
          },
          "cache_ratio": {
            "type": [
              "null",
              "number"
            ]
          },
          "cache_read": {
            "type": [
              "integer",
              "null"
            ]
          },
          "duration": {
            "type": [
              "null",
              "number"
            ]
          },
          "errors": {
            "type": [
              "integer",
              "null"
            ]
          },
          "finish": {
            "type": "string"
          },
          "index": {
            "type": [
              "integer",
              "null"
            ]
          },
          "model_id": {
            "type": "string"
          },
          "non_cache_per_sec": {
            "type": [
              "null",
              "number"
            ]
          },
          "non_cache_tokens": {
            "type": [
              "integer",
              "null"
            ]
          },
          "output_input_ratio": {
            "type": [
              "null",
              "number"
            ]
          },
          "patch_parts": {
            "type": [
              "integer",
              "null"
            ]
          },
          "reasoning_parts": {
            "type": [
              "integer",
              "null"
            ]
          },
          "role": {
            "type": "string"
          },
          "text_parts": {
            "type": [
              "integer",
              "null"
            ]
          },
          "tokens_input": {
            "type": [
              "integer",
              "null"
            ]
          },
          "tokens_output": {
            "type": [
              "integer",
              "null"
            ]
          },
          "tokens_per_sec": {
            "type": [
              "null",
              "number"
            ]
          },
          "tokens_total": {
            "type": [
              "integer",
              "null"
            ]
          },
          "tool_calls": {
            "type": [
              "integer",
              "null"
            ]
          },
          "tool_time_share": {
            "type": [
              "number",
              "null"
            ]
          },
          "tool_time_sum": {
            "type": [
              "number",
              "null"
            ]
          },
          "availability": {
            "type": "object",
            "additionalProperties": {
              "enum": [
                "observed",
                "partial",
                "unavailable",
                "unknown"
              ]
            }
          }
        }
      }
    },
    "availability": {
      "type": "object",
      "required": [
        "status",
        "basis",
        "fields"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed",
            "partial",
            "unavailable",
            "unknown"
          ]
        },
        "basis": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "status",
              "observed",
              "partial",
              "total",
              "reasons"
            ],
            "properties": {
              "status": {
                "enum": [
                  "observed",
                  "partial",
                  "unavailable",
                  "unknown"
                ]
              },
              "observed": {
                "type": "integer",
                "minimum": 0
              },
              "partial": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "reasons": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
