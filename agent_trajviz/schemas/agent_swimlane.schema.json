{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent swimlane",
  "description": "Each agent's contiguous step ranges with their tokens and tool calls; the user has a lane of its own.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "description",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "const": "agent_swimlane"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "const": "chart"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "lanes"
      ],
      "properties": {
        "lanes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "color_index",
              "id",
              "label",
              "segments"
            ],
            "properties": {
              "color_index": {
                "type": [
                  "null",
                  "integer"
                ]
              },
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "segments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "end",
                    "start",
                    "steps",
                    "tokens",
                    "tool_calls"
                  ],
                  "properties": {
                    "end": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "start": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "steps": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "tokens": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "tool_calls": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "availability": {
      "type": "object",
      "required": [
        "status",
        "basis",
        "fields"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed",
            "partial",
            "unavailable",
            "unknown"
          ]
        },
        "basis": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "status",
              "observed",
              "partial",
              "total",
              "reasons"
            ],
            "properties": {
              "status": {
                "enum": [
                  "observed",
                  "partial",
                  "unavailable",
                  "unknown"
                ]
              },
              "observed": {
                "type": "integer",
                "minimum": 0
              },
              "partial": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "reasons": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
