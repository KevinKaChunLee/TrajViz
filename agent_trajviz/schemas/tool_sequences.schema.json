{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tool sequences",
  "description": "Recurring sequences of tool calls.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "description",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "const": "tool_sequences"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "const": "table"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "frequency",
          "sequence",
          "step_indices"
        ],
        "properties": {
          "frequency": {
            "type": "integer"
          },
          "sequence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "step_indices": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
