{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow phases",
  "description": "Contiguous structural phases of the run (exploration, editing, validation, ...).",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "description",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "const": "phases"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "const": "table"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "end_idx",
          "name",
          "start_idx"
        ],
        "properties": {
          "end_idx": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "start_idx": {
            "type": "integer"
          }
        }
      }
    }
  }
}
