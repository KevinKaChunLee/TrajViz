{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tool selection anti-patterns",
  "description": "Shell commands used where a dedicated tool exists (for example `cat` instead of Read).",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "description",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "const": "tool_selection"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "const": "table"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "pattern",
          "step"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "pattern": {
            "type": "string"
          },
          "step": {
            "type": "integer"
          }
        }
      }
    }
  }
}
