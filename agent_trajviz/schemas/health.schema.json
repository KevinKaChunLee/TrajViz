{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Health checks",
  "description": "One verdict per check (good/warn/bad) with the value it judged and why.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "description",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "const": "health"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "const": "table"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "detail",
          "label",
          "metric",
          "status"
        ],
        "properties": {
          "detail": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "metric": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "good",
              "warn",
              "bad"
            ]
          }
        }
      }
    }
  }
}
